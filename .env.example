# Required for Auth.js session encryption. Generate one with:
#   npx auth secret
AUTH_SECRET=

# GitHub OAuth App credentials.
# Create the app at https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# In production, swap localhost:3000 for your deployed origin.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- CLI script only (npm run dev-diary) ---
GITHUB_TOKEN=
OPENAI_API_KEY=
SINCE_DATE=2025-09-01
# UNTIL_DATE=2026-09-12
# SCOPE=org:your-org
# GRANULARITY=month
# MODEL=gpt-4.1-mini
